generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  BIOMED_TECH
  DEPT_MANAGER
  STAFF
  VIEWER

  @@map("user_role")
}

model User {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supabaseUserId          String?                  @unique(map: "users_supabase_user_id_key") @map("supabase_user_id") @db.Uuid
  email                   String
  fullName                String                   @map("full_name")
  role                    Role
  departmentId            String?                  @map("department_id") @db.Uuid
  phone                   String?
  isActive                Boolean                  @default(true) @map("is_active")
  isSeedData              Boolean                  @default(false) @map("is_seed_data")
  lastLoginAt             DateTime?                @map("last_login_at") @db.Timestamptz(3)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  department              Department?              @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  managedDepartments      Department[]             @relation("DepartmentManager")
  machineStatusChanges    MachineStatusHistory[]   @relation("MachineStatusChangedBy")
  requestedBookings       Booking[]                @relation("BookingRequester")
  approvedBookings        Booking[]                @relation("BookingApprover")
  usageSessions           UsageSession[]           @relation("UsageSessionUser")
  reportedServiceTickets  ServiceTicket[]          @relation("ServiceTicketReporter")
  assignedServiceTickets  ServiceTicket[]          @relation("ServiceTicketAssignee")
  serviceRecords          ServiceRecord[]          @relation("ServiceRecordPerformer")
  auditLogs               AuditLog[]               @relation("AuditLogActor")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  uploadedAttachments     Attachment[]             @relation("AttachmentUploader")

  @@index([departmentId], map: "users_department_id_idx")
  @@map("users")
}

model Department {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String     @unique(map: "departments_name_key")
  code          String     @unique(map: "departments_code_key")
  managerUserId String?    @map("manager_user_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  manager       User?      @relation("DepartmentManager", fields: [managerUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  members       User[]     @relation("DepartmentMembers")
  locations     Location[]
  machines      Machine[]  @relation("MachineDepartment")

  @@index([managerUserId], map: "departments_manager_user_id_idx")
  @@map("departments")
}

model Location {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId String     @map("department_id") @db.Uuid
  name         String
  building     String?
  floor        String?
  room         String?
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  machines     Machine[]  @relation("MachineLocation")

  @@unique([departmentId, name], map: "locations_department_id_name_key")
  @@map("locations")
}

enum MachineCondition {
  OPERATIONAL
  NEEDS_SERVICE
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
  RETIRED

  @@map("machine_condition")
}

enum MachineStatusSource {
  MANUAL
  SERVICE_TICKET
  SCHEDULE
  SYSTEM

  @@map("machine_status_source")
}

model MachineCategory {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String    @unique(map: "machine_categories_name_key")
  description                String?
  defaultServiceIntervalDays Int?      @map("default_service_interval_days")
  defaultMaxBookingMinutes   Int?      @map("default_max_booking_minutes")
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  machines                   Machine[]

  @@map("machine_categories")
}

model Machine {
  id                           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetTag                     String                 @unique(map: "machines_asset_tag_key") @default(dbgenerated("next_machine_asset_tag()")) @map("asset_tag")
  name                         String
  categoryId                   String                 @map("category_id") @db.Uuid
  manufacturer                 String
  model                        String
  serialNumber                 String                 @map("serial_number")
  description                  String?
  departmentId                 String                 @map("department_id") @db.Uuid
  locationId                   String                 @map("location_id") @db.Uuid
  purchaseDate                 DateTime?              @map("purchase_date") @db.Date
  warrantyExpiresOn            DateTime?              @map("warranty_expires_on") @db.Date
  commissionedOn               DateTime?              @map("commissioned_on") @db.Date
  retiredOn                    DateTime?              @map("retired_on") @db.Date
  condition                    MachineCondition       @default(OPERATIONAL)
  isBookable                   Boolean                @default(true) @map("is_bookable")
  requiresApproval             Boolean                @default(false) @map("requires_approval")
  allowBookingWhenNeedsService Boolean                @default(false) @map("allow_booking_when_needs_service")
  maxBookingMinutes            Int?                   @map("max_booking_minutes")
  bufferMinutes                Int?                   @map("buffer_minutes")
  serviceIntervalDays          Int?                   @map("service_interval_days")
  lastServicedAt               DateTime?              @map("last_serviced_at") @db.Timestamptz(3)
  nextServiceDueAt             DateTime?              @map("next_service_due_at") @db.Timestamptz(3)
  deletedAt                    DateTime?              @map("deleted_at") @db.Timestamptz(3)
  createdAt                    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  category                     MachineCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  department                   Department             @relation("MachineDepartment", fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  location                     Location               @relation("MachineLocation", fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  statusHistory                MachineStatusHistory[] @relation("MachineStatusHistory")
  bookings                     Booking[]
  usageSessions                UsageSession[]
  serviceTickets               ServiceTicket[]
  maintenanceSchedules         MaintenanceSchedule[]

  @@index([departmentId], map: "machines_department_id_idx")
  @@index([categoryId], map: "machines_category_id_idx")
  @@index([condition], map: "machines_condition_idx")
  @@index([nextServiceDueAt], map: "machines_next_service_due_at_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "machines_name_trgm_idx")
  @@index([assetTag(ops: raw("gin_trgm_ops"))], type: Gin, map: "machines_asset_tag_trgm_idx")
  @@index([serialNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "machines_serial_number_trgm_idx")
  @@map("machines")
}

model MachineStatusHistory {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  machineId       String              @map("machine_id") @db.Uuid
  fromCondition   MachineCondition?   @map("from_condition")
  toCondition     MachineCondition    @map("to_condition")
  reason          String
  changedByUserId String              @map("changed_by_user_id") @db.Uuid
  source          MachineStatusSource
  ticketId        String?             @map("ticket_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  machine         Machine             @relation("MachineStatusHistory", fields: [machineId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  changedByUser   User                @relation("MachineStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ticket          ServiceTicket?      @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([machineId, createdAt(sort: Desc)], map: "machine_status_history_machine_id_created_at_idx")
  @@index([ticketId], map: "machine_status_history_ticket_id_idx")
  @@map("machine_status_history")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW

  @@map("booking_status")
}

model Booking {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  machineId         String         @map("machine_id") @db.Uuid
  requestedByUserId String         @map("requested_by_user_id") @db.Uuid
  startsAt          DateTime       @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime       @map("ends_at") @db.Timestamptz(3)
  blockedUntil      DateTime       @map("blocked_until") @db.Timestamptz(3)
  status            BookingStatus
  purpose           String
  approvedByUserId  String?        @map("approved_by_user_id") @db.Uuid
  decisionNote      String?        @map("decision_note")
  cancelledReason   String?        @map("cancelled_reason")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  machine           Machine        @relation(fields: [machineId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestedByUser   User           @relation("BookingRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedByUser    User?          @relation("BookingApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usageSessions     UsageSession[]

  @@index([machineId, startsAt], map: "bookings_machine_id_starts_at_idx")
  @@index([requestedByUserId, startsAt], map: "bookings_requested_by_user_id_starts_at_idx")
  @@index([status, startsAt], map: "bookings_status_starts_at_idx")
  @@map("bookings")
}

model UsageSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  machineId     String    @map("machine_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  bookingId     String?   @map("booking_id") @db.Uuid
  startedAt     DateTime  @map("started_at") @db.Timestamptz(3)
  expectedEndAt DateTime? @map("expected_end_at") @db.Timestamptz(3)
  endedAt       DateTime? @map("ended_at") @db.Timestamptz(3)
  purpose       String
  endNote       String?   @map("end_note")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  machine       Machine   @relation(fields: [machineId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user          User      @relation("UsageSessionUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  booking       Booking?  @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, startedAt], map: "usage_sessions_user_id_started_at_idx")
  @@map("usage_sessions")
}

enum ServiceTicketSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("service_ticket_severity")
}

enum ServiceTicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED

  @@map("service_ticket_status")
}

enum ServiceTicketType {
  FAULT
  PREVENTIVE
  CALIBRATION
  INSPECTION

  @@map("service_ticket_type")
}

model ServiceTicket {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  machineId               String                 @map("machine_id") @db.Uuid
  reportedByUserId        String                 @map("reported_by_user_id") @db.Uuid
  title                   String
  description             String
  severity                ServiceTicketSeverity
  status                  ServiceTicketStatus    @default(OPEN)
  assignedToUserId        String?                @map("assigned_to_user_id") @db.Uuid
  type                    ServiceTicketType
  openedAt                DateTime               @default(now()) @map("opened_at") @db.Timestamptz(3)
  resolvedAt              DateTime?              @map("resolved_at") @db.Timestamptz(3)
  closedAt                DateTime?              @map("closed_at") @db.Timestamptz(3)
  machineOutOfServiceFrom DateTime?              @map("machine_out_of_service_from") @db.Timestamptz(3)
  machineBackInServiceAt  DateTime?              @map("machine_back_in_service_at") @db.Timestamptz(3)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  machine                 Machine                @relation(fields: [machineId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reportedByUser          User                   @relation("ServiceTicketReporter", fields: [reportedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedToUser          User?                  @relation("ServiceTicketAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  records                 ServiceRecord[]
  statusHistory           MachineStatusHistory[]

  @@index([machineId, status], map: "service_tickets_machine_id_status_idx")
  @@index([assignedToUserId, status], map: "service_tickets_assigned_to_user_id_status_idx")
  @@index([status, severity], map: "service_tickets_status_severity_idx")
  @@index([machineId, openedAt(sort: Desc)], map: "service_tickets_machine_id_opened_at_idx")
  @@map("service_tickets")
}

model ServiceRecord {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId          String        @map("ticket_id") @db.Uuid
  performedByUserId String        @map("performed_by_user_id") @db.Uuid
  performedAt       DateTime      @map("performed_at") @db.Timestamptz(3)
  workDone          String        @map("work_done")
  partsReplaced     String?       @map("parts_replaced")
  costAmount        Int?          @map("cost_amount")
  currency          String        @default("KES")
  nextDueAt         DateTime?     @map("next_due_at") @db.Timestamptz(3)
  vendorName        String?       @map("vendor_name")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  ticket            ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  performedByUser   User          @relation("ServiceRecordPerformer", fields: [performedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketId, performedAt], map: "service_records_ticket_id_performed_at_idx")
  @@map("service_records")
}

model MaintenanceSchedule {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  machineId    String    @map("machine_id") @db.Uuid
  intervalDays Int       @map("interval_days")
  lastDoneAt   DateTime? @map("last_done_at") @db.Timestamptz(3)
  nextDueAt    DateTime? @map("next_due_at") @db.Timestamptz(3)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  machine      Machine   @relation(fields: [machineId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("maintenance_schedules")
}

enum AttachmentEntityType {
  MACHINE
  TICKET

  @@map("attachment_entity_type")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  before      Json?    @db.JsonB
  after       Json?    @db.JsonB
  ip          String?  @db.Inet
  requestId   String   @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actorUser   User?    @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([entityType, entityId, createdAt(sort: Desc)], map: "audit_logs_entity_type_entity_id_created_at_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "audit_logs_actor_user_id_created_at_idx")
  @@index([createdAt(sort: Desc)], map: "audit_logs_created_at_idx")
  @@map("audit_logs")
}

model Notification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String
  title      String
  body       String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  emailedAt  DateTime? @map("emailed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, readAt], map: "notifications_user_id_read_at_idx")
  @@map("notifications")
}

model NotificationPreference {
  userId    String   @map("user_id") @db.Uuid
  type      String
  inApp     Boolean  @default(true) @map("in_app")
  email     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([userId, type], map: "notification_preferences_pkey")
  @@map("notification_preferences")
}

model Attachment {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType       AttachmentEntityType @map("entity_type")
  entityId         String               @map("entity_id") @db.Uuid
  storagePath      String               @unique(map: "attachments_storage_path_key") @map("storage_path")
  fileName         String               @map("file_name")
  mimeType         String               @map("mime_type")
  sizeBytes        Int                  @map("size_bytes")
  uploadedByUserId String               @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  uploadedByUser   User                 @relation("AttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([entityType, entityId], map: "attachments_entity_type_entity_id_idx")
  @@map("attachments")
}

model AppSetting {
  key       String   @id
  value     Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}
