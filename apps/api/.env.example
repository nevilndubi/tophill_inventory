# Required now
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@EP-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@EP-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_SERVER_ONLY_KEY

# Optional explicit overrides; when omitted, both are derived from SUPABASE_URL
SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Local defaults
NODE_ENV=development
PORT=3001
REDIS_URL=redis://127.0.0.1:6379

# Explicit database integration suite only (dedicated ci/, test/, or ephemeral/ Neon branch)
INTEGRATION_DATABASE_URL=
INTEGRATION_DATABASE_BRANCH=

# Explicit demo seed only; exact branch/host confirmation plus protected hosts
SEED_ALLOWED_BRANCH=
SEED_ALLOWED_HOST=
SEED_PROTECTED_HOSTS=

# Optional Task 1.7 live-verification helper; project identifier only, never a credential
NEON_PROJECT_ID=

# Optional until their documented phases
RESEND_API_KEY=
SENTRY_DSN=
