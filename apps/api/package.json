{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPatterns=src",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPatterns=test",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.cjs --runInBand"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.8",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.16.3",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/cli": "12.0.9",
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.16.0",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
