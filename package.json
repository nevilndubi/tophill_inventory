{
  "name": "tophill-inventory",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.22.0",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "dev": "pnpm --filter @app/shared build && pnpm --parallel --stream --filter @app/shared --filter @app/web --filter @app/api run dev",
    "prebuild": "pnpm prisma:generate",
    "build": "pnpm --filter @app/shared build && pnpm --filter @app/web build && pnpm --filter @app/api build && pnpm exec tsx scripts/assert-api-production-build.ts",
    "lint": "eslint apps packages prisma scripts prisma7.config.ts --max-warnings=0",
    "lint:fix": "eslint apps packages prisma scripts prisma7.config.ts --fix --max-warnings=0",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "pretypecheck": "pnpm prisma:generate",
    "typecheck": "tsc --noEmit -p tsconfig.prisma.json && pnpm --recursive --if-present run typecheck",
    "pretest": "pnpm prisma:generate",
    "test": "pnpm --filter @app/shared build && pnpm --recursive --if-present run test",
    "test:e2e:machines": "pnpm --filter @app/web test:e2e:machines",
    "pretest:integration": "pnpm prisma:generate",
    "test:integration": "pnpm --filter @app/api test:integration",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "prisma db seed --config prisma7.config.ts",
    "db:seed:verify": "tsx prisma/verify-seed.ts",
    "db:index-review": "tsx prisma/verify-seed.ts --sequence-proof --index-review",
    "verify:neon:task-1.7": "tsx prisma/verify-neon-task-1-7.ts",
    "verify:supabase:auth": "tsx scripts/verify-supabase-auth.ts",
    "verify:users:live": "tsx scripts/verify-user-management-live.ts",
    "verify:categories:live": "tsx scripts/verify-categories-live.ts",
    "verify:reference:live": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json tsx scripts/verify-reference-data-live.ts",
    "verify:machines:live": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json tsx scripts/verify-machines-live.ts",
    "verify:conditions:live": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json tsx scripts/verify-condition-live.ts",
    "verify:usage:live": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json tsx scripts/verify-usage-live.ts",
    "verify:status:live": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json tsx scripts/verify-status-live.ts",
    "verify:machine-import:live": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json tsx scripts/verify-machine-import-live.ts",
    "verify:attachments:live": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json tsx scripts/verify-attachments-live.ts",
    "storage:configure": "tsx scripts/configure-supabase-storage.ts",
    "storage:reconcile": "tsx scripts/reconcile-attachment-storage.ts",
    "users:reconcile-auth": "pnpm --filter @app/api exec tsx src/scripts/reconcile-auth-identities.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@prisma/adapter-pg": "7.10.1",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
